+export async function fetchWebApi(endpoint, method = 'GET', body, token) {
+  if (!token) {
+    throw new Error('AUTH_EXPIRED');
+  }
+  let res;
+  try {
+    res = await fetch(`https://api.spotify.com/${endpoint}`, {
+      headers: {
+        Authorization: `Bearer ${token}`,
+        'Content-Type': 'application/json',
+      },
+      method,
+      body: body ? JSON.stringify(body) : undefined,
+    });
+  } catch {
+    throw new Error('RATE_LIMITED');
+  }
+  if (res.status === 401) {
+    throw new Error('AUTH_EXPIRED');
+  }
+  if (res.status === 429 || !res.ok) {
+    throw new Error('RATE_LIMITED');
+  }
+  return await res.json();
+}
+
+export async function getTopTracks(token, timeRange = 'long_term', limit = 50) {
+  const data = await fetchWebApi(
+    `v1/me/top/tracks?time_range=${timeRange}&limit=${limit}`,
+    'GET',
+    undefined,
+    token
+  );
+  return Array.isArray(data?.items) ? data.items : [];
+}
+
+export async function createPlaylistWithTracks(
+  token,
+  tracksUri,
+  name = 'My top tracks playlist'
+) {
+  if (!Array.isArray(tracksUri) || tracksUri.length === 0) {
+    throw new Error('EMPTY_TRACKS');
+  }
+  const playlist = await fetchWebApi(
+    'v1/me/playlists',
+    'POST',
+    {
+      name,
+      description: 'Playlist created by the tutorial on developer.spotify.com',
+      public: false,
+    },
+    token
+  );
+  await fetchWebApi(
+    `v1/playlists/${playlist.id}/items?uris=${tracksUri.join(',')}`,
+    'POST',
+    undefined,
+    token
+  );
+  return playlist;
+}
