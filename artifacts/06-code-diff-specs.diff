@@ -0,0 +1,252 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import { getTopTracks, createPlaylistWithTracks } from '../utils/spotifyApi';
+import {
+  RESTING_THEME,
+  computeNextVisualState,
+  applyThemeToDocument,
+} from '../utils/beatVisualizer';
+import {
+  TIME_RANGE_OPTIONS,
+  DEFAULT_EMBED_PLAYLIST_ID,
+} from '../data/fallbackCatalog';
+import GraphicEqualizer from '../components/GraphicEqualizer';
+import TrackCard from '../components/TrackCard';
+import EmbedPlayer from '../components/EmbedPlayer';
+
+export default function Dashboard({
+  initialToken = 'pkce-session-token',
+  initialBpm = 128,
+}) {
+  const [token, setToken] = useState(initialToken);
+  const [timeRange, setTimeRange] = useState('long_term');
+  const [tracks, setTracks] = useState([]);
+  const [activePlaylistId, setActivePlaylistId] = useState(
+    DEFAULT_EMBED_PLAYLIST_ID
+  );
+  const [isPlaying, setIsPlaying] = useState(false);
+  const [visualState, setVisualState] = useState(RESTING_THEME);
+  const [authError, setAuthError] = useState(false);
+  const [rateLimitError, setRateLimitError] = useState(false);
+
+  const loadTracks = useCallback(
+    async (activeToken, selectedRange) => {
+      try {
+        setRateLimitError(false);
+        const items = await getTopTracks(activeToken, selectedRange, 50);
+        setTracks(items);
+        setAuthError(false);
+      } catch (err) {
+        if (err.message === 'AUTH_EXPIRED') {
+          setAuthError(true);
+          setToken('');
+          setIsPlaying(false);
+          setVisualState(RESTING_THEME);
+          applyThemeToDocument(RESTING_THEME);
+        } else {
+          setRateLimitError(true);
+          setIsPlaying(false);
+          setVisualState(RESTING_THEME);
+          applyThemeToDocument(RESTING_THEME);
+        }
+      }
+    },
+    []
+  );
+
+  useEffect(() => {
+    loadTracks(token, timeRange);
+  }, [token, timeRange, loadTracks]);
+
+  useEffect(() => {
+    if (!isPlaying) {
+      setVisualState(RESTING_THEME);
+      applyThemeToDocument(RESTING_THEME);
+      return undefined;
+    }
+    let tick = 0;
+    const next = computeNextVisualState({
+      isPlaying: true,
+      bpm: initialBpm,
+      tickCount: tick,
+    });
+    setVisualState(next);
+    applyThemeToDocument(next);
+    const timerId = setInterval(() => {
+      tick += 1;
+      const beatState = computeNextVisualState({
+        isPlaying: true,
+        bpm: initialBpm,
+        tickCount: tick,
+      });
+      setVisualState(beatState);
+      applyThemeToDocument(beatState);
+    }, next.intervalMs);
+    return () => clearInterval(timerId);
+  }, [isPlaying, initialBpm]);
+
+  const handleSavePlaylist = async () => {
+    if (tracks.length === 0) return;
+    try {
+      const uris = tracks.map((t) => t.uri);
+      const created = await createPlaylistWithTracks(
+        token,
+        uris,
+        'My top tracks playlist'
+      );
+      if (created?.id) {
+        setActivePlaylistId(created.id);
+      }
+    } catch (err) {
+      if (err.message === 'AUTH_EXPIRED') {
+        setAuthError(true);
+        setIsPlaying(false);
+        setVisualState(RESTING_THEME);
+        applyThemeToDocument(RESTING_THEME);
+      } else {
+        setRateLimitError(true);
+      }
+    }
+  };
+
+  return (
+    <main
+      data-testid="spotify-dashboard"
+      style={{
+        backgroundColor: visualState.backgroundColor,
+        color: visualState.foregroundColor,
+        border: `2px solid ${visualState.foregroundColor}`,
+        boxShadow: visualState.isBeatPulse
+          ? `0 0 18px ${visualState.foregroundColor}`
+          : 'none',
+      }}
+    >
+      {authError && (
+        <div
+          role="alert"
+          data-testid="auth-error-banner"
+          style={{
+            color: visualState.foregroundColor,
+            border: `1px solid ${visualState.foregroundColor}`,
+          }}
+        >
+          <p>Session expired. Please re-authenticate.</p>
+          <button
+            type="button"
+            style={{
+              color: visualState.foregroundColor,
+              borderColor: visualState.foregroundColor,
+            }}
+            onClick={() => {
+              setAuthError(false);
+              setToken('pkce-reconnected-token');
+            }}
+          >
+            Reconnect Spotify (PKCE)
+          </button>
+        </div>
+      )}
+
+      {rateLimitError && (
+        <div
+          role="alert"
+          data-testid="rate-limit-banner"
+          style={{
+            color: visualState.foregroundColor,
+            border: `1px solid ${visualState.foregroundColor}`,
+          }}
+        >
+          <p>Network or rate limit reached. Beat visualizer paused.</p>
+          <button
+            type="button"
+            style={{
+              color: visualState.foregroundColor,
+              borderColor: visualState.foregroundColor,
+            }}
+            onClick={() => loadTracks(token, timeRange)}
+          >
+            Retry Request
+          </button>
+        </div>
+      )}
+
+      <section
+        aria-label="Time Range Controls"
+        style={{
+          color: visualState.foregroundColor,
+          borderBottom: `1px solid ${visualState.foregroundColor}`,
+        }}
+      >
+        {TIME_RANGE_OPTIONS.map((opt) => (
+          <button
+            key={opt.optionId}
+            type="button"
+            style={{
+              backgroundColor: '#000000',
+              color: visualState.foregroundColor,
+              border: `1px solid ${visualState.foregroundColor}`,
+            }}
+            onClick={() => setTimeRange(opt.rangeKey)}
+          >
+            {opt.displayLabel}
+          </button>
+        ))}
+        <button
+          type="button"
+          disabled={tracks.length === 0}
+          style={{
+            backgroundColor: '#000000',
+            color: visualState.foregroundColor,
+            border: `2px solid ${visualState.foregroundColor}`,
+          }}
+          onClick={handleSavePlaylist}
+        >
+          Save to Playlist
+        </button>
+      </section>
+
+      {tracks.length === 0 ? (
+        <div
+          data-testid="empty-tracks-state"
+          style={{
+            color: visualState.foregroundColor,
+            border: `1px dashed ${visualState.foregroundColor}`,
+          }}
+        >
+          <p>No tracks found for this time range. Try another filter.</p>
+        </div>
+      ) : (
+        <ul
+          data-testid="tracks-list"
+          style={{
+            color: visualState.foregroundColor,
+            borderColor: visualState.foregroundColor,
+          }}
+        >
+          {tracks.map((track) => (
+            <TrackCard
+              key={track.id}
+              track={track}
+              foregroundColor={visualState.foregroundColor}
+              isBeatPulse={visualState.isBeatPulse}
+            />
+          ))}
+        </ul>
+      )}
+
+      <GraphicEqualizer
+        bars={visualState.equalizerBars}
+        foregroundColor={visualState.foregroundColor}
+        isBeatPulse={visualState.isBeatPulse}
+        isPlaying={isPlaying}
+      />
+
+      <EmbedPlayer
+        playlistId={activePlaylistId}
+        isPlaying={isPlaying}
+        onTogglePlay={() => setIsPlaying((prev) => !prev)}
+        foregroundColor={visualState.foregroundColor}
+        isBeatPulse={visualState.isBeatPulse}
+      />
+    </main>
+  );
+}
